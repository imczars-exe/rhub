{
  "name": "retro-deck",
  "version": "1.0.2",
  "description": "RHub - app de escritorio para tu macropad 3x3 con pantalla TFT y ESP32-C3",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "@serialport/parser-readline": "^12.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.11",
    "serialport": "^12.0.0",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": "Meiker",
  "build": {
    "appId": "com.meiker.retrodeck",
    "productName": "RHub",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "script.js",
      "styles.css",
      "spotify.js",
      "spotify-actions.js",
      "display.js",
      "i18n.js",
      "widgets.js",
      "spotify-oled.js"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      { "provider": "github", "owner": "imczars-exe", "repo": "rhub" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RHub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "artifactName": "RHub-Setup-${version}.${ext}"
    }
  }
}
